{
  "manifest_version": 3,
  "name": "SKK Lite for Inputs",
  "version": "0.5.7",
  "description": "SKK-like Japanese input only inside Chrome page inputs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SKK Lite for Inputs",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-skk-kana": {
      "suggested_key": {
        "default": "Ctrl+J",
        "mac": "Ctrl+J"
      },
      "description": "Enable SKK kana mode or commit current conversion"
    },
    "open-clipboard-input": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open SKK clipboard input"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "skk_engine.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}
